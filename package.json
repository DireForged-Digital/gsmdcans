{
  "name": "gsmdcans",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/analytics": "~26.4.0",
    "@react-native-firebase/app": "~26.4.0",
    "@react-native-firebase/app-check": "~26.4.0",
    "@react-native-firebase/auth": "~26.4.0",
    "@react-native-firebase/crashlytics": "~26.4.0",
    "@react-native-firebase/firestore": "~26.4.0",
    "@react-native-firebase/functions": "~26.4.0",
    "@react-native-firebase/messaging": "~26.4.0",
    "@react-native-firebase/remote-config": "~26.4.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-legal": "^1.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/functions/",
      "<rootDir>/firebase/",
      "<rootDir>/e2e-web/",
      "\\.emulator\\.test\\.ts$"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/services/firebase/**",
      "!src/test/**",
      "!**/*.d.ts",
      "!src/**/*.web.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 70
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:prod": "APP_VARIANT=production expo prebuild --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor && npx expo install --check",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm --filter rules-tests test\"",
    "test:functions": "firebase emulators:exec --only firestore,auth \"npm --prefix functions test\"",
    "e2e": "scripts/e2e-native.sh",
    "e2e:ios": "scripts/e2e-native.sh ios",
    "e2e:android": "scripts/e2e-native.sh android",
    "e2e:web": "pnpm web:export && pnpm --filter e2e-web test",
    "e2e:a11y": "scripts/e2e-native.sh 'ios android' 'large-text dark'"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": []
      }
    }
  },
  "private": true,
  "packageManager": "pnpm@12.11.2"
}
